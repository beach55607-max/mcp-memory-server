# Copy this file to wrangler.toml and fill in your own values
# DO NOT commit wrangler.toml — it contains your personal Cloudflare resource IDs

name = "mcp-memory-server"
main = "src/index.ts"
compatibility_date = "2024-12-01"
compatibility_flags = ["nodejs_compat"]

[ai]
binding = "AI"

[[d1_databases]]
binding = "DB"
database_name = "memory-db"
database_id = "<YOUR_D1_DATABASE_ID>"     # wrangler d1 create memory-db

[[vectorize]]
binding = "VECTORIZE"
index_name = "memory-index"               # wrangler vectorize create memory-index --dimensions=1024 --metric=cosine

[[kv_namespaces]]
binding = "OAUTH_KV"
id = "<YOUR_KV_NAMESPACE_ID>"             # wrangler kv namespace create OAUTH_KV

[vars]
MCP_ENABLED = "true"
WRITE_ENABLED = "true"
# API_SECRET — set via `wrangler secret put API_SECRET` (required for production REST API access)
ALLOWED_ORIGINS = ""                      # Comma-separated origins (default: claude.ai, chatgpt.com, etc.)
DEV_MODE = "false"                        # Set "true" for local dev (allows localhost CORS + skips API_SECRET check)
CRON_ENABLED = "true"                     # Daily governance cron (decay, dedup, AI judge, consolidation)
SUMMARY_ENABLED = "true"                  # AI-generated summaries on save (requires Workers AI neurons)
SUPERSEDE_ENABLED = "true"                # Auto-supersede similar memories on save

# Daily cron trigger — runs governance at UTC 03:00
[triggers]
crons = ["0 3 * * *"]
